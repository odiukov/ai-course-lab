# Нужен только для импорта уроков. Уже импортированные уроки читаются без него.
COURSE_REPO=/absolute/path/to/ai-engineering-from-scratch
# Рут-репозиторий курса: отсюда кнопка импорта тянет свежую версию в .cache/course-repo
UPSTREAM_REPO=https://github.com/rohitg00/ai-engineering-from-scratch.git
UPSTREAM_BRANCH=main
AGENT=claude
# Интерпретатор для pytest и замера (по умолчанию python3)
PYTHON=
# Порт моста pyright-langserver (по умолчанию 3001)
LSP_PORT=
