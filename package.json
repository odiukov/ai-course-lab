{
  "name": "ai-course-lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "audit:arithmetic": "tsx scripts/audit-arithmetic.mts",
    "audit:cards": "tsx scripts/audit-cards.mts",
    "audit:lessons": "node scripts/audit-lessons.mjs",
    "audit:math": "tsx scripts/audit-math.mts",
    "audit:phase19": "tsx scripts/audit-phase-19.mts",
    "book:build": "tsx scripts/build-book.mts",
    "book:publish": "tsx scripts/publish-book.mts",
    "build": "next build",
    "cards:write": "tsx --env-file-if-exists=.env.local scripts/write-cards.mts",
    "dev": "node scripts/dev.mjs",
    "dev:lsp": "tsx scripts/lsp-bridge.mts",
    "dev:next": "next dev",
    "generate:course": "zsh scripts/generate-course-queue.zsh",
    "import": "tsx --env-file=.env.local scripts/import-lesson.mjs",
    "lint": "eslint",
    "lsp:probe": "tsx scripts/lsp-probe.mts",
    "site:build": "npm run site:pages && npm run site:index",
    "site:index": "pagefind --site out --force-language ru",
    "site:pages": "tsx --env-file-if-exists=.env.local scripts/build-site.mts",
    "site:publish": "npm run site:build && npm run book:publish && tsx scripts/publish-site.mts",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "fast-xml-parser": "^5.10.1",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.4.0",
    "katex": "^0.16.47",
    "monaco-editor": "^0.56.0",
    "next": "16.3.0",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "happy-dom": "^20.11.2",
    "pagefind": "1.5.2",
    "pyodide": "^314.0.3",
    "pyright": "^1.1.411",
    "remark-parse": "^11.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5",
    "unified": "^11.0.5",
    "vitest": "^4.1.10"
  }
}
