    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "happy-dom": "^20.11.2",
    "pyodide": "^314.0.3",
    "pyright": "^1.1.411",
    "tailwindcss": "^4",
